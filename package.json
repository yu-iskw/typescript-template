{
  "name": "calculator-poc-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Calculator POC demonstrating multi-client monorepo architecture",
  "keywords": ["calculator", "monorepo", "react", "expo", "mcp"],
  "license": "Apache-2.0",
  "author": "",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@calculator/api",
    "dev:web": "turbo run dev --filter=@calculator/web",
    "dev:mobile": "turbo run dev --filter=@calculator/mobile",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "trunk fmt",
    "format:all": "trunk fmt --all"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=24.13.0",
    "pnpm": ">=10.28.1"
  }
}
