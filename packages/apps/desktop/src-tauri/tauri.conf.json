{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Calculator POC",
  "version": "1.0.0",
  "identifier": "com.calculator.poc",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Calculator POC",
        "width": 420,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 320,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
