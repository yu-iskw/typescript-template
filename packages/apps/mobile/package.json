{
  "name": "@calculator/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "echo Mobile build: See README for type check notes || exit 0",
    "build:export": "expo export --platform ios --platform android",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .expo dist"
  },
  "dependencies": {
    "@calculator/api-client": "workspace:*",
    "@calculator/engine": "workspace:*",
    "@calculator/ui": "workspace:*",
    "expo": "~52.0.0",
    "expo-constants": "~17.0.0",
    "expo-linking": "~7.0.0",
    "expo-router": "~4.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "^18.3.1",
    "react-native": "0.76.7",
    "react-native-safe-area-context": "4.14.0",
    "react-native-screens": "~4.4.0"
  },
  "devDependencies": {
    "@calculator/tsconfig": "workspace:*",
    "@types/react": "~18.3.0",
    "typescript": "^5.9.3"
  }
}
