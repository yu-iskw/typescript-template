{
  "name": "@calculator/ui",
  "version": "1.0.0",
  "private": true,
  "description": "Shared UI components for calculator apps",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./hooks": {
      "import": "./dist/hooks/index.js",
      "types": "./dist/hooks/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@calculator/engine": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@calculator/tsconfig": "workspace:*",
    "@types/react": "^19.0.8",
    "react": "^19.0.0",
    "typescript": "^5.9.3"
  }
}
